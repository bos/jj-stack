{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jj-stack.dev/schemas/json-output.schema.json",
  "title": "jj-stack JSON command output",
  "description": "Public JSON output for jj-stack view --json and list --json, and one record of --output=jsonl.",
  "oneOf": [
    {
      "$ref": "#/$defs/viewOutput"
    },
    {
      "$ref": "#/$defs/listOutput"
    },
    {
      "$ref": "#/$defs/jsonlRecord"
    }
  ],
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "subject",
        "status",
        "needs_submit",
        "needs_sync"
      ],
      "properties": {
        "change_id": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/changeStatus"
        },
        "needs_submit": {
          "type": "boolean"
        },
        "needs_sync": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "repair": {
          "type": "string"
        },
        "current": {
          "const": true
        },
        "pr": {
          "$ref": "#/$defs/pr"
        }
      }
    },
    "changeStatus": {
      "type": "string",
      "enum": [
        "unsubmitted",
        "submitted",
        "open",
        "queued",
        "draft",
        "approved",
        "changes_requested",
        "review_required",
        "merged",
        "closed",
        "missing",
        "ambiguous",
        "link_mismatch",
        "branch_moved",
        "divergent",
        "unknown"
      ]
    },
    "jsonlRecord": {
      "description": "One line of --output=jsonl: a message, the current activity, a --json payload, or an accepted merge request.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "enum": [
                "output",
                "note",
                "warning",
                "error"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "status"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "data"
          ],
          "properties": {
            "type": {
              "const": "result"
            },
            "data": {
              "oneOf": [
                {
                  "$ref": "#/$defs/viewOutput"
                },
                {
                  "$ref": "#/$defs/listOutput"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "pr",
            "state",
            "head_change_id"
          ],
          "properties": {
            "type": {
              "const": "merge_requested"
            },
            "pr": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "number",
                "url"
              ],
              "properties": {
                "number": {
                  "type": "integer"
                },
                "url": {
                  "type": "string"
                }
              }
            },
            "state": {
              "enum": [
                "pending",
                "enqueued"
              ]
            },
            "head_change_id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "listOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listRow"
          }
        }
      }
    },
    "listRow": {
      "oneOf": [
        {
          "$ref": "#/$defs/stackRow"
        },
        {
          "$ref": "#/$defs/orphanRow"
        }
      ]
    },
    "orphanRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "change_id",
        "branch",
        "subject",
        "status"
      ],
      "properties": {
        "type": {
          "const": "orphan"
        },
        "change_id": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "const": "orphan"
        },
        "pr": {
          "$ref": "#/$defs/pr"
        }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "number"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "checks": {
          "type": "string",
          "description": "Combined result of the checks GitHub has received; passing does not mean every required check has run.",
          "enum": [
            "passed",
            "failed",
            "pending"
          ]
        },
        "merge_state_status": {
          "type": "string",
          "description": "GitHub's reported mergeStateStatus; independent of reviews and checks."
        },
        "merge_details": {
          "$ref": "#/$defs/mergeDetails"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "mergeDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_threads",
        "checks"
      ],
      "properties": {
        "unresolved_threads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "is_outdated",
              "path",
              "line",
              "body",
              "url"
            ],
            "properties": {
              "is_outdated": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "body": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          }
        },
        "mergeable": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge_checks": {
          "$ref": "#/$defs/mergeDetails/properties/checks"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolve_threads": {
          "type": "boolean"
        }
      }
    },
    "stackRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subject",
        "status",
        "head_change_id",
        "changes"
      ],
      "properties": {
        "type": {
          "const": "stack"
        },
        "current": {
          "const": true
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "Human-readable stack summary; derive machine state from changes"
        },
        "head_change_id": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    },
    "viewOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stacks"
      ],
      "properties": {
        "stacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewStack"
          }
        }
      }
    },
    "viewStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_change_id",
        "changes"
      ],
      "properties": {
        "head_change_id": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    }
  }
}
